    {
      "id": "pHOOpAEetSC7hyO4ymvky",
      "type": "text",
      "x": -237.00077388835825,
      "y": -807.9388467556967,
      "width": 783.3277587890625,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
