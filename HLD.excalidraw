    {
      "id": "AFyk9cu_oCCqq-L4xXp5A",
      "type": "text",
      "x": -1411.9986480404639,
      "y": -749.9947607891945,
      "width": 580.9718017578125,
      "height": 945,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 932584427,
      "version": 792,
      "versionNonce": 1465396258,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756625121425,
      "link": null,
      "locked": false,
      "text": "1. Responsive UI\n2. Debouncing\n3. Throttling\n4. Pagination of suggestions\n   . Offset based approach\n   . Cursor based approach\n5. Virtualized list\n6. Accessibility \n    . ARIA roles\n    . Keyboard navigation\n    . Colour contrast\n    . Readable font sizes\n    . WCAG compliance\n7. Performance\n8. Security\n9. Handling different states for better UX\n    . Auto focus on search input\n    . No network\n    . Error -> retry API with backoff\n    . Loading\n10. Caching\n11. Logging/ Monitoring\n12. Localization / Internationalisation\n13. Testing -> Jest, RTL\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Responsive UI\n2. Debouncing\n3. Throttling\n4. Pagination of suggestions\n   . Offset based approach\n   . Cursor based approach\n5. Virtualized list\n6. Accessibility \n    . ARIA roles\n    . Keyboard navigation\n    . Colour contrast\n    . Readable font sizes\n    . WCAG compliance\n7. Performance\n8. Security\n9. Handling different states for better UX\n    . Auto focus on search input\n    . No network\n    . Error -> retry API with backoff\n    . Loading\n10. Caching\n11. Logging/ Monitoring\n12. Localization / Internationalisation\n13. Testing -> Jest, RTL\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
