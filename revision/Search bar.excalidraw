    {
      "id": "pHOOpAEetSC7hyO4ymvky",
      "type": "text",
      "x": 1384.8351636116417,
      "y": -273.09509675569666,
      "width": 783.3277587890625,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 326713003,
      "version": 650,
      "versionNonce": 1005944613,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756431586688,
      "link": null,
      "locked": false,
      "text": "Search input change\nEvent listeners onChange\nDebounced to prevent unnecessary api call\nThrottling on search button\nAborting pending request using Abort Controller\n\n\n\nCaching\n    1. Key: query , Value : resp\n        Pros: O(1) fetching from cache\n        Cons: Redunancy, memory heavy\n                Duplicates stored\n\n   2. Store each result item once.\n        Pros: Memory efficient.\n        Cons: Filtering required on client side\n\n   3.  Normalized structure : Hybrid of first 2 approaches\n        \n         cache = {\n                    id1: item1,\n                    id2: item2,\n                }",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Search input change\nEvent listeners onChange\nDebounced to prevent unnecessary api call\nThrottling on search button\nAborting pending request using Abort Controller\n\n\n\nCaching\n    1. Key: query , Value : resp\n        Pros: O(1) fetching from cache\n        Cons: Redunancy, memory heavy\n                Duplicates stored\n\n   2. Store each result item once.\n        Pros: Memory efficient.\n        Cons: Filtering required on client side\n\n   3.  Normalized structure : Hybrid of first 2 approaches\n        \n         cache = {\n                    id1: item1,\n                    id2: item2,\n                }",
      "autoResize": true,
      "lineHeight": 1.25
    },
