    {
      "id": "AFyk9cu_oCCqq-L4xXp5A",
      "type": "text",
      "x": 210.07855830240737,
      "y": -215.4444061849992,
      "width": 580.9718017578125,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 932584427,
      "version": 507,
      "versionNonce": 1652992587,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756431843824,
      "link": null,
      "locked": false,
      "text": "1. Responsive UI\n2. Debouncing\n3. Throttling\n4. Pagination of suggestions\n   . Offset based approach\n   . Cursor based approach\n5. Virtualized list\n6. Accessibility \n    . ARIA roles\n    . Keyboard navigation\n7. Performance\n8. Security\n9. Handling different states for better UX\n    . No network\n    . Error -> retry API with backoff\n    . Loading\n10. Caching\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Responsive UI\n2. Debouncing\n3. Throttling\n4. Pagination of suggestions\n   . Offset based approach\n   . Cursor based approach\n5. Virtualized list\n6. Accessibility \n    . ARIA roles\n    . Keyboard navigation\n7. Performance\n8. Security\n9. Handling different states for better UX\n    . No network\n    . Error -> retry API with backoff\n    . Loading\n10. Caching\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
